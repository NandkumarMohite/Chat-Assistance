          "name": "endDate",
          "in": "query",
          "type": "string",
          "required": false,
          "description": "Get the cycle time ending at this date/time."
        },
        {
          "name": "aggLevel",
          "in": "query",
          "type": "string",
          "required": false,
          "description": "Aggregation level used for grouping cycle-time data (e.g. hourly, daily, weekly)."
        },
        {
          "name": "aggregate",
