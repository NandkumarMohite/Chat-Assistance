            "required": true,
            "description": "The user's ID who made the purchase"
          },
          {
            "name": "productId",
            "type": "Long",
            "required": true,
            "description": "The product ID that was purchased"
          },
          {
            "name": "quantity",
            "type": "Integer",
            "required": true,
            "description": "How many units were purchased"
          }
        ]
      },
