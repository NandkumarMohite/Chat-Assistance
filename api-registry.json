  "_TODO_HOW_TO_ADD_NEW_API": "To add a New API to the AI Assistant, you ONLY need to add a new object inside the 'apis' array below! NO JavaScript code changes are needed in server.js or anywhere else. The AI will automatically read the new API, understand its description, and start using it.",
  "apis": [
    {
      "id": "get_device_status_history",
      "name": "Get Device Status History",
      "description": "Retrieves the historical status changes for a specific device from MongoDB. Supports filtering by edge, collector, device, time range, and optional status value.",
      "method": "GET",
      "path": "/edgemonitor/device-status-history",
      "parameters": [
        {
          "name": "edgeId",
          "in": "query",
          "type": "String",
          "required": false,
          "description": "The unique ID of the edge device"
        },
        {
          "name": "collectorId",
          "in": "query",
          "type": "String",
          "required": false,
          "description": "The unique ID of the collector"
        },
        {
          "name": "deviceId",
          "in": "query",
          "type": "String",
          "required": false,
          "description": "The unique ID of the monitored device"
        },
        {
          "name": "status",
          "in": "query",
          "type": "String",
          "required": false,
          "description": "Optional status filter (e.g. running, down, connected, disconnected, )"
        },
        {
          "name": "from",
          "in": "query",
          "type": "String",
          "required": true,
          "description": "Start timestamp for filtering history records"
        },
        {
          "name": "to",
          "in": "query",
          "type": "String",
          "required": true,
          "description": "End timestamp for filtering history records"
        }
      ],
      "responseExample": [
        {
          "deviceId": "device-101",
          "deviceType": "sensor",
          "collectorId": "collector-11",
          "edgeId": "edge-1",
          "lastUpdatedTimestamp": "2026-05-12T03:52:18.760Z",
          "status": [
            {
              "status": "running",
              "statusStartedAt": "2026-05-12T03:52:18.760Z"
            }
          ]
        }
      ],
      "keywords": [
        "device history",
        "status history",
        "historical statuses",
        "device monitoring history",
        "device status logs",
        "status timeline",
        "get all statuses for device",
        "It is only for specific device, not for all devices"
      ]
    },
