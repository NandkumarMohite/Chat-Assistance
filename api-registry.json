{
  "baseUrl": "http://placeholder-overridden-by-env/api/v1",
  "serviceName": "Comau",
  "description": "Comau backend API — manages users, products, categories, purchases, and more.",
  "dependencyChains": [
    {
      "id": "purchases_by_user_phone",
      "description": "Get purchase history for a user identified by phone number. First fetches all users, filters by phone, extracts userId, then fetches purchases for that user.",
      "triggerKeywords": [
        "purchase",
        "order",
        "bought",
        "history"
      ],
      "triggerCondition": "user identifies a person by phone number (not by ID)",
      "steps": [
        {
          "apiId": "get_all_users",
          "filterBy": "phone",
          "filterValueFrom": "userInput",
          "extractField": "id",
          "saveAs": "resolvedUserId"
        },
        {
          "apiId": "get_purchases_by_user",
          "pathParams": {
            "userId": "$resolvedUserId"
          }
        }
      ]
    },
    {
      "id": "purchases_by_user_email",
      "description": "Get purchase history for a user identified by email. First fetches all users, filters by email, extracts userId, then fetches purchases for that user.",
      "triggerKeywords": [
        "purchase",
        "order",
        "bought",
        "history"
      ],
      "triggerCondition": "user identifies a person by email address (not by ID)",
      "steps": [
        {
          "apiId": "get_all_users",
          "filterBy": "email",
          "filterValueFrom": "userInput",
          "extractField": "id",
          "saveAs": "resolvedUserId"
        },
        {
          "apiId": "get_purchases_by_user",
          "pathParams": {
            "userId": "$resolvedUserId"
          }
        }
      ]
    },
    {
      "id": "purchases_by_user_name",
      "description": "Get purchase history for a user identified by name. First fetches all users, filters by name, extracts userId, then fetches purchases for that user.",
      "triggerKeywords": [
        "purchase",
        "order",
        "bought",
        "history"
      ],
      "triggerCondition": "user identifies a person by their name (not by ID)",
      "steps": [
        {
          "apiId": "get_all_users",
          "filterBy": "name",
          "filterValueFrom": "userInput",
          "extractField": "id",
          "saveAs": "resolvedUserId"
        },
        {
          "apiId": "get_purchases_by_user",
          "pathParams": {
            "userId": "$resolvedUserId"
          }
        }
      ]
    }
