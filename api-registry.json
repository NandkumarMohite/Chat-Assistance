{
  "baseUrl": "http://localhost:8080",
  "serviceName": "Comau",
  "description": "Comau backend API — manages users, products, categories, purchases, and more.",
  "dependencyChains": [
    {
      "id": "purchases_by_user_phone",
      "description": "Get purchase history for a user identified by phone number. First fetches all users, filters by phone, extracts userId, then fetches purchases for that user.",
      "triggerKeywords": [
        "purchase",
        "order",
        "bought",
        "history"
      ],
      "triggerCondition": "user identifies a person by phone number (not by ID)",
      "steps": [
        {
          "apiId": "get_all_users",
          "filterBy": "phone",
          "filterValueFrom": "userInput",
          "extractField": "id",
          "saveAs": "resolvedUserId"
        },
        {
          "apiId": "get_purchases_by_user",
          "pathParams": {
            "userId": "$resolvedUserId"
          }
        }
      ]
    },
    {
      "id": "purchases_by_user_email",
      "description": "Get purchase history for a user identified by email. First fetches all users, filters by email, extracts userId, then fetches purchases for that user.",
      "triggerKeywords": [
        "purchase",
        "order",
        "bought",
        "history"
      ],
      "triggerCondition": "user identifies a person by email address (not by ID)",
      "steps": [
        {
          "apiId": "get_all_users",
          "filterBy": "email",
          "filterValueFrom": "userInput",
          "extractField": "id",
          "saveAs": "resolvedUserId"
        },
        {
          "apiId": "get_purchases_by_user",
          "pathParams": {
            "userId": "$resolvedUserId"
          }
        }
      ]
    },
    {
      "id": "purchases_by_user_name",
      "description": "Get purchase history for a user identified by name. First fetches all users, filters by name, extracts userId, then fetches purchases for that user.",
      "triggerKeywords": [
        "purchase",
        "order",
        "bought",
        "history"
      ],
      "triggerCondition": "user identifies a person by their name (not by ID)",
      "steps": [
        {
          "apiId": "get_all_users",
          "filterBy": "name",
          "filterValueFrom": "userInput",
          "extractField": "id",
          "saveAs": "resolvedUserId"
        },
        {
          "apiId": "get_purchases_by_user",
          "pathParams": {
            "userId": "$resolvedUserId"
          }
        }
      ]
    }
  ],
  "_TODO_HOW_TO_ADD_NEW_API": "To add a New API to the AI Assistant, you ONLY need to add a new object inside the 'apis' array below! NO JavaScript code changes are needed in server.js or anywhere else. The AI will automatically read the new API, understand its description, and start using it.",
  "apis": [
    {
      "id": "get_all_sellers",
      "name": "Get All Sellers",
      "description": "Get All Sellers in the shop.",
      "method": "GET",
      "path": "/api/sellers",
      "parameters": [],
      "keywords": [
        "get all Salers",
        "all workers in shop",
        "shop workers",
        "salers mans"
      ]
    },
    {
      "id": "get_all_users",
      "name": "Get All Users",
      "description": "Retrieves a list of all registered users in the system. Use when the user asks about all customers, or to find a specific user by email, name, or phone number (you will fetch all and filter the results).",
      "method": "GET",
      "path": "/api/users",
      "parameters": [],
      "responseExample": [
        {
          "id": 1,
          "name": "John Doe",
          "email": "john@example.com",
          "phone": "9876543210"
        }
      ],
      "keywords": [
        "users",
        "customers",
        "all users",
        "list users",
        "how many users",
        "user count",
        "registered users",
        "members",
        "find user by email",
        "search user",
        "user email"
      ]
    },
    {
      "id": "get_user_by_id",
      "name": "Get User By ID",
      "description": "Retrieves details of a single user by their numeric ID ONLY. Do NOT use this to find a user by email, name, or phone. Use get_all_users if searching by email.",
      "method": "GET",
      "path": "/api/users/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "Long",
          "required": true,
          "description": "The user's unique ID"
        }
      ],
      "responseExample": {
        "id": 1,
        "name": "John Doe",
        "email": "john@example.com",
        "phone": "9876543210"
      },
      "keywords": [
        "user details",
        "specific user",
        "user by id",
        "get user by id"
      ]
    },
    {
