# 🚀 Server Configuration
PORT=3000

# 🤖 Ollama Microservice Configuration
# Use 'http://ollama-service:11434' when running in Docker Compose
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# 🏢 Backend Microservice Configuration
# Use 'https://chat-assistant-bff:8500/api/v1' when running in Docker Compose
BACKEND_URL=http://localhost:8013/api/v1

# 🧪 Local Testing Mode
# Set to 'true' to skip real BFF API calls and use mock data from core/test-mock-data.js
# Useful for testing UI without running all backend services
TEST_LOCALLY=true
