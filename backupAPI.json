            "number of cycles"
        ],
        "responseHints": [
            "duration (array of cycle durations)",
            "max (maximum cycle time)",
            "min (minimum cycle time)",
            "std (standard deviation)",
            "nCycles (total number of cycles)"
        ]
    },
