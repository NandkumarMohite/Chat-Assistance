[
    {
        "id": "get_time_between_cycles",
        "name": "Get Time Between Cycles",
        "category": "cycle_time",
        "priority": 3,
        "disambiguationHints": [
            "Use for time GAP between cycles, not cycle duration",
            "Good for 'time between cycles', 'cycle intervals', 'gap between production'",
            "Returns duration arrays showing inter-cycle timing",
            "Different from get_cycle_times which measures cycle duration itself"
        ],
        "description": "Retrieves the average aggregation of time between production cycles for one or more stations within a given time interval. Supports filtering by model, aggregation level, pagination, and optional aggregation mode.",
        "method": "GET",
        "path": "/bff/time-between-cycles",
        "parameters": [
            {
                "name": "stationIds",
                "in": "query",
                "type": "string",
                "required": false,
                "description": "Comma seperated String of station IDs to retrieve cycle time data for."
            },
            {
                "name": "model",
                "in": "query",
                "type": "string",
                "required": false,
                "description": "Model identifier used to filter cycle data."
            },
            {
                "name": "startDate",
                "in": "query",
                "type": "string",
                "required": false,
                "description": "Start date/time of the interval for retrieving cycle aggregation data."
            },
            {
                "name": "endDate",
                "in": "query",
                "type": "string",
                "required": false,
                "description": "End date/time of the interval for retrieving cycle aggregation data."
            },
            {
                "name": "aggLevel",
                "in": "query",
                "type": "string",
                "required": false,
                "description": "Aggregation level used for grouping cycle data (e.g. hourly, daily, weekly)."
            },
            {
                "name": "aggregate",
                "in": "query",
                "type": "boolean",
                "required": false,
                "description": "If true, returns aggregated cycle information. Default value is false."
            }
        ],
        "responseExample": [
            {
                "stationId": 1,
                "modelId": "MODEL_A",
                "duration": [
                    45,
                    50,
                    47
                ],
                "max": [
                    55
                ],
                "min": [
                    40
                ],
                "std": [
                    3
                ],
                "nCycles": 120
            }
        ],
        "possible_API_structure": [
            {
                "URL": "baseURL/bff/time-between-cycles?startDate=2026-05-01T00:00:00Z&endDate=2026-05-02T00:00:00Z&aggLevel=hourly",
                "method": "GET"
            },
            {
                "URL": "baseURL/bff/time-between-cycles?stations=1,2&startDate=2026-05-01T00:00:00Z&endDate=2026-05-02T00:00:00Z&aggLevel=daily&aggregate=true",
                "method": "GET"
            },
            {
                "URL": "baseURL/bff/time-between-cycles?stations=1&model=MODEL_A&startDate=2026-05-01T00:00:00Z&endDate=2026-05-31T23:59:59Z&aggLevel=weekly",
                "method": "GET"
            }
        ],
        "errorResponses": [
            {
                "code": 400,
                "description": "Invalid request parameters or missing required fields"
            },
            {
                "code": 404,
                "description": "No cycle data found for the specified filters"
            },
            {
                "code": 500,
                "description": "Server error"
            }
        ],
        "keywords": [
            "time between cycles",
            "cycle time",
            "cycle aggregation",
            "production cycles",
            "station cycles",
            "average cycle duration",
            "cycle statistics",
            "manufacturing analytics",
            "cycle performance",
            "time aggregation",
            "station production metrics",
            "cycle duration",
